# Copy to /opt/dj_money/.env on the VM and fill in. Never commit the real file.

# --- used by docker-compose.gcp.yml ---
DOMAIN=money.example.com
CLOUDSQL_INSTANCE=<project-id>:australia-southeast1:dj-money-pg
REDIS_PASSWORD=<random>
BACKUP_BUCKET=<project-id>-backups

# --- Django ---
DEBUG=False
SECRET_KEY=<random 50+ chars>
ALLOWED_HOSTS=money.example.com
CSRF_TRUSTED_ORIGINS=https://money.example.com
SECURE_COOKIES=True
DATABASE_URL=postgres://dj_money:<db-password>@cloudsql:5432/dj_money
CELERY_BROKER_URL=redis://:<redis-password>@redis:6379/0

# --- external services ---
# Statement storage: GCS via its S3-compatible API (names kept from the Yandex era)
YANDEX_ENDPOINT=https://storage.googleapis.com
YANDEX_BUCKET=<project-id>-statements
YANDEX_ACCESS_KEY=<HMAC access id>
YANDEX_SECRET_KEY=<HMAC secret>
# Recent boto3 sends checksums that S3-compatible stores may reject
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
YANDEX_GPT_SECRET_KEY=
YANDEX_ID_FOLDER=
OPENAI_API_KEY=
DOWNLOAD_API_TOKEN=
