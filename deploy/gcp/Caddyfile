{$DOMAIN} {
	encode gzip

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	@django path /api /api/* /admin /admin/* /accounts /accounts/* /money /money/* /blog /blog/*
	handle @django {
		reverse_proxy web:8000
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
